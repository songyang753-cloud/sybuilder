    {
      "id": "E03",
      "action": "21 字名称保存",
      "assertion": "document.getElementById('error').textContent==='任务名称不能超过 20 个字符' && items.length===1",
      "result": "PASS"
    },
    {
      "id": "E04",
      "action": "20 字名称保存",
      "assertion": "items.length===2 && items[1].name.length===20",
      "result": "PASS"
