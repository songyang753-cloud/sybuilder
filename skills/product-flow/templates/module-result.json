  "moduleId": "<注册表模块 ID>",
  "inputsHash": "<对 inputs 的 canonical JSON SHA-256>",
  "producedAt": "<RFC3339>",
  "supersedes": "<上一 resultId；首次为空>",
  "registryVersion": "<来源 registryVersion>",
  "registryHash": "<来源 registryHash>",
  "claimCeiling": "exploration | draft | review-ready | module-approved",
  "inputs": [{"ref": "", "version": "", "authority": "", "access": ""}],
  "outputs": [{"ref": "", "sha256": "", "authority": ""}],
  "gateResults": [{"gate": "", "ruleId": "R-…", "verdict": "PASS | FAIL | UNABLE | NOT-RUN | N/A", "recordRef": ""}],
  "assumptions": [],
  "stopLines": [],
  "unresolvedDependencies": [],
  "backfills": [],
  "limitations": ["<本模块验不了什么；必填>"],
  "moduleResultHash": "<签发时计算>"
}
